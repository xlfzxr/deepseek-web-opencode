{
  "name": "codex-deepseek-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prelogin": "node scripts/ensure-adb.mjs",
    "login": "node --require ./src/android-preload.cjs src/login.mjs",
    "start": "node --require ./src/android-preload.cjs src/server.mjs",
    "smoke": "node --require ./src/android-preload.cjs scripts/smoke.mjs",
    "test": "npm run smoke && npm run test:dsml && npm run test:orchestration && npm run test:arch && npm run test:headers && npm run test:toolcall",
    "test:dsml": "node --require ./src/android-preload.cjs scripts/test-dsml.mjs",
    "test:orchestration": "node --require ./src/android-preload.cjs scripts/test-orchestration.mjs",
    "test:arch": "node scripts/test-architecture.mjs",
    "test:headers": "node --require ./src/android-preload.cjs scripts/test-headers.mjs",
    "test:toolcall": "node --require ./src/android-preload.cjs scripts/test-tool-call.mjs",
    "test:live": "node --require ./src/android-preload.cjs scripts/live-check.mjs",
    "fingerprint:capture": "node scripts/fingerprint-from-capture.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.54.2"
  }
}
