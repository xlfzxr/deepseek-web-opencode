{
  "name": "deepseek-web-opencode",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prelogin": "npm run prelogin --workspace=@deepseek-web-opencode/api",
    "login": "npm run login --workspace=@deepseek-web-opencode/api --ignore-scripts",
    "start": "npm run start --workspace=@deepseek-web-opencode/api",
    "fingerprint:capture": "npm run fingerprint:capture --workspace=@deepseek-web-opencode/api --",
    "capture:browser": "npm run capture:browser --workspace=@deepseek-web-opencode/deepseek-web --",
    "replay": "npm run replay --workspace=@deepseek-web-opencode/api --"
  }
}
